# Copy to .env for local `vercel dev`. In production, set these in
# Vercel → Project → Settings → Environment Variables instead — don't commit .env.

# --- Hugging Face (free-tier chat model) ---
# Create a free token at https://huggingface.co/settings/tokens (Read access is enough).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any instruct-tuned chat model available on HF's free Inference API works here.
# Qwen2.5-7B-Instruct is a solid free, ungated, strongly multilingual default.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Razorpay (payment status lookups + support CC) ---
# Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay doesn't expose a public "create ticket" API for merchants — looping
# them in on gateway-level issues happens by email, hence this CC address.
RAZORPAY_SUPPORT_EMAIL=your-razorpay-account-manager@razorpay.com

# --- Email escalation (SMTP) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASS=xxxxxxxxxxxxxxxxxxxx
SUPPORT_EMAIL=support@yourdomain.com

# --- Telegram escalation ---
# Create a bot via @BotFather, add it to your ops group, then grab the chat_id.
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890
